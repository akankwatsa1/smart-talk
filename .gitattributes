# Normalise line endings so a Windows checkout does not break the Linux build.
# gradlew is a shell script: CRLF in it makes CI fail with a confusing
# "bad interpreter" error rather than a useful message.
* text=auto

*.sh      text eol=lf
gradlew   text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets must never be line-ending translated.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.jks     binary
*.keystore binary
*.jar     binary
*.zip     binary
*.exe     binary
*.wav     binary
*.mp3     binary
